-- Halo at head
table.insert(UIConnections, RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    local head = char and char:FindFirstChild("Head")
    if not head then return end

    if Config.HaloEnabled then
        if not localHaloPart or localHaloPart.Parent ~= char then
            if localHaloPart then localHaloPart:Destroy() end
            localHaloPart = Instance.new("Part")
            localHaloPart.Name = "Jlife_Halo"
            localHaloPart.Size = Vector3.new(1.35, 0.04, 1.35)
            localHaloPart.Material = Enum.Material.Neon
            localHaloPart.Color = Config.TrailColor
            localHaloPart.CanCollide = false
            localHaloPart.Massless = true
            localHaloPart.Transparency = 0.15
            localHaloPart.Parent = char

            local mesh = Instance.new("SpecialMesh")
            mesh.MeshType = Enum.MeshType.Cylinder
            mesh.Parent = localHaloPart
        end
        trailAngle = (trailAngle + 135 * dt) % 360
        localHaloPart.CFrame = head.CFrame * CFrame.new(0, 1.65, 0) * CFrame.Angles(0, math.rad(trailAngle), 0)
    elseif localHaloPart then
        localHaloPart:Destroy()
        localHaloPart = nil
    end
end))

-- Ribbon Trail
local function applyRibbonTrail(char)
    if not Config.RibbonTrailEnabled then return end
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    if not torso then return end

    if localRibbonTrail then localRibbonTrail:Destroy() end
    if ribbonAttachment0 then ribbonAttachment0:Destroy() end
    if ribbonAttachment1 then ribbonAttachment1:Destroy() end

    ribbonAttachment0 = Instance.new("Attachment")
    ribbonAttachment0.Position = Vector3.new(0, 1.2, 0)
    ribbonAttachment0.Parent = torso

    ribbonAttachment1 = Instance.new("Attachment")
    ribbonAttachment1.Position = Vector3.new(0, -1.2, 0)
    ribbonAttachment1.Parent = torso

    localRibbonTrail = Instance.new("Trail")
    localRibbonTrail.Attachment0 = ribbonAttachment0
    localRibbonTrail.Attachment1 = ribbonAttachment1
    localRibbonTrail.FaceCamera = true
    localRibbonTrail.Lifetime = Config.TrailFadeSpeed
    localRibbonTrail.WidthScale = NumberSequence.new(Config.TrailWidth)
