inputBox.FocusLost:Connect(function(enter)
    if not enter then return end
    local cmd = inputBox.Text:lower()
    inputBox.Text = ""

    if cmd:find("speed") then
        local val = tonumber(cmd:match("%d+"))
        if val then Config.WalkSpeed = val; JLog("Speed set to " .. val, "Success") end
    elseif cmd:find("gravity") then
        local val = tonumber(cmd:match("%d+"))
        if val then workspace.Gravity = val; JLog("Gravity set to " .. val, "Success") end
    elseif cmd == "esp" then
        Config.EspEnabled = not Config.EspEnabled
        JLog("ESP toggled", "Success")
    elseif cmd == "unload" or cmd == "kill" then
        UnloadJlife()
    else
        JLog("Unknown command", "Error")
    end
end)

