-- Main ESP Loop (Highlight + Billboard + Wall Check Glow)
table.insert(UIConnections, RunService.RenderStepped:Connect(function()
    if not Config.EspEnabled then
        for _, hl in pairs(HighlightObjects) do if hl then hl:Destroy() end end
        HighlightObjects = {}
        for p in pairs(BillboardObjects) do removePlayerESP(p) end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")

        local allowed = true
        local team = getTeamName(player)
        if Config.EspOnlyShow ~= "All" then
            if Config.EspOnlyShow == "Guards" and team ~= "Guards" then allowed = false end
            if Config.EspOnlyShow == "Inmates" and team ~= "Inmates" then allowed = false end
            if Config.EspOnlyShow == "Criminals" and team ~= "Criminals" then allowed = false end
        end
        if not hum or hum.Health <= 0 then allowed = false end

        if allowed and head then
            -- Highlight (Glow ESP)
            local hl = HighlightObjects[player]
            if not hl or hl.Parent ~= char then
                if hl then hl:Destroy() end
                hl = Instance.new("Highlight")
                hl.Name = "Jlife_GlowESP"
                hl.Adornee = char
                hl.Parent = char
                HighlightObjects[player] = hl
            end

            local obstructed = Config.EspWallCheck and isWallBetween(head)

            if obstructed then
                hl.FillColor = getSelectedColor(Config.ObstructedColor)
                hl.FillTransparency = 0.45
                hl.OutlineColor = getSelectedColor(Config.ObstructedColor)
                hl.OutlineTransparency = 0.65
            else
                hl.FillColor = getSelectedColor(Config.VisibleColor)
                hl.FillTransparency = 0.08
                hl.OutlineColor = getSelectedColor(Config.VisibleColor)
                hl.OutlineTransparency = 0.35
            end

            -- Billboard Avatar + Health
            if Config.EspShowAvatar or Config.EspShowHealth then
                if not BillboardObjects[player] then
                    createPlayerESP(player)
                end

                local bb = BillboardObjects[player]
                if bb then
                    local healthFill = bb:FindFirstChild("HealthFill", true)
                    if healthFill and hum then
                        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        healthFill.Size = UDim2.new(ratio, 0, 1, 0)
                        healthFill.BackgroundColor3 = Color3.fromHSV(ratio * 0.33, 1, 1)
                    end
                end
            end
        else
            if HighlightObjects[player] then
                HighlightObjects[player]:Destroy()
                HighlightObjects[player] = nil
            end
            removePlayerESP(player)
        end
    end

    -- Tracers
    if not Config.TracersEnabled then
        for _, line in pairs(TracerObjects) do if line then line:Destroy() end end
        TracerObjects = {}
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if hrp and hum and hum.Health > 0 then
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local line = TracerObjects[player]
                if not line then
                    line = Instance.new("Frame")
                    line.Name = "Tracer"
                    line.BorderSizePixel = 0
                    line.AnchorPoint = Vector2.new(0, 0.5)
                    line.Parent = drawGui
                    TracerObjects[player] = line
                end

                local startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                local endPos = Vector2.new(screenPos.X, screenPos.Y)
                local dist = (endPos - startPos).Magnitude

                line.Size = UDim2.new(0, dist, 0, 1.4)
                line.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
                line.Rotation = math.deg(math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X))
                line.BackgroundColor3 = getSelectedColor(Config.VisibleColor)
            else
                if TracerObjects[player] then
                    TracerObjects[player]:Destroy()
                    TracerObjects[player] = nil
                end
            end
        end
    end
end))

