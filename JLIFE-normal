local consoleLogCallback = nil
local function JLog(text, logType)
    logType = logType or "Info"
    local timestamp = os.date("%H:%M:%S")
    local logString = string.format("[%s] [%s] %s", timestamp, logType:upper(), text)
    
    if consoleLogCallback then
        consoleLogCallback(logString, logType)
    end
end

