local function UnloadJlife()
    for _, conn in pairs(UIConnections) do if conn then conn:Disconnect() end end
    UIConnections = {}

    for _, gui in ipairs(ScreenGuis) do if gui then gui:Destroy() end end
    ScreenGuis = {}

    for _, hl in pairs(HighlightObjects) do if hl then hl:Destroy() end end
    HighlightObjects = {}

    for _, line in pairs(TracerObjects) do if line then line:Destroy() end end
    TracerObjects = {}

    for _, bbg in pairs(BillboardObjects) do if bbg then bbg:Destroy() end end
    BillboardObjects = {}

    if LocalPlayerLight then LocalPlayerLight:Destroy() end
    if localHaloPart then localHaloPart:Destroy() end
    if localRibbonTrail then localRibbonTrail:Destroy() end
    if ribbonAttachment0 then ribbonAttachment0:Destroy() end
    if ribbonAttachment1 then ribbonAttachment1:Destroy() end

    for _, p in pairs(circleTrailParts) do if p then p:Destroy() end end
    circleTrailParts = {}
    for _, e in pairs(particleEmitters) do if e then e:Destroy() end end
    particleEmitters = {}

    Lighting.Ambient = originalLighting.Ambient
    Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
    Lighting.Brightness = originalLighting.Brightness
    Lighting.ClockTime = originalLighting.ClockTime
    Lighting.GlobalShadows = originalLighting.GlobalShadows

    print("[Jlife v2.0] Unloaded successfully.")
end

