local function addSlider(parent, text, minV, maxV, default, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 50)
    f.BackgroundColor3 = Theme.BackgroundLight
    f.BackgroundTransparency = 0.35
    f.BorderSizePixel = 0
    f.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 5)
    c.Parent = f

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.55, 0, 0.38, 0)
    lbl.Position = UDim2.new(0, 10, 0.1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextColor3 = Theme.TextMain
    lbl.TextSize = 10
    lbl.Text = text
    lbl.Parent = f

    local valBox = Instance.new("TextBox")
    valBox.Size = UDim2.new(0, 38, 0, 17)
    valBox.Position = UDim2.new(1, -46, 0.1, 0)
    valBox.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    valBox.Font = Enum.Font.GothamBold
    valBox.TextColor3 = Theme.TextMain
    valBox.TextSize = 9
    valBox.Text = tostring(default)
    valBox.Parent = f

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -20, 0, 3)
    track.Position = UDim2.new(0, 10, 0.72, 0)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    track.BorderSizePixel = 0
    track.Parent = f

    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(1, 0)
    tCorner.Parent = track

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Theme.TextMain
    fill.BorderSizePixel = 0
    fill.Parent = track

    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(1, 0)
    fCorner.Parent = fill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 9, 0, 9)
    knob.Position = UDim2.new(0, 0, 0.5, -4.5)
    knob.BackgroundColor3 = Theme.TextMain
    knob.Parent = track

    local kCorner = Instance.new("UICorner")
    kCorner.CornerRadius = UDim.new(1, 0)
    kCorner.Parent = knob

    local current = default
    local function setValue(v)
        current = math.clamp(v, minV, maxV)
        valBox.Text = tostring(math.floor(current))
        local ratio = (current - minV) / (maxV - minV)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, -4.5, 0.5, -4.5)
        callback(current)
    end

    setValue(default)

    local sliding = false
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            local pos = math.clamp(input.Position.X - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
            local ratio = pos / track.AbsoluteSize.X
            setValue(minV + ratio * (maxV - minV))
        end
    end)

    valBox.FocusLost:Connect(function()
        local num = tonumber(valBox.Text)
        if num then setValue(num) else valBox.Text = tostring(current) end
    end)
end

